# License server settings. For local development run `npm run setup:dev`,
# which writes .env.local with development values. In production set these in
# Vercel > Project > Settings > Environment Variables; mark secrets Sensitive.

# Postgres connection string (Neon's pooled endpoint). Locally: pglite:./.data/dev
DATABASE_URL=
# Neon's direct endpoint, used by `npm run db:migrate` when set.
DATABASE_URL_UNPOOLED=

# Public address of this server. Products send activations here.
APP_URL=https://license.enerceon.com
# Name shown in the dashboard and page titles.
APP_NAME=ENERCEON License Server
# Time zone for dates in the dashboard.
TIME_ZONE=Asia/Karachi

# License signing key: create with `npm run keys:generate -- --issuer https://license.enerceon.com`
# and paste the two lines from .secrets/<kid>.env. Secret; keep an offline copy of the .pem.
LICENSE_SIGNING_KID=
LICENSE_SIGNING_KEY=
# `iss` of issued licenses. Defaults to APP_URL; never change it once products are built.
# LICENSE_ISSUER=

# 32 random bytes, base64 (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Secret. Changing either one makes every stored key unusable.
KEY_HMAC_SECRET=
KEY_ENCRYPTION_KEY=

# One-time code that unlocks /setup to create the first administrator.
# At least 24 random characters; remove it after setup.
SETUP_TOKEN=

# Only these e-mail domains may request dashboard access (comma-separated), e.g. vizualtechs.com.
# Empty lets anyone request access; an administrator still approves every request.
SIGNUP_ALLOWED_DOMAINS=

# Activation limits per network address and hour.
# ACTIVATIONS_PER_HOUR_PER_IP=30
# INVALID_KEYS_PER_HOUR_PER_IP=10
